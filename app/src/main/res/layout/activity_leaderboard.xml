<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/leaderboardMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    tools:context=".LeaderboardActivity">

    <!-- Top Header -->
    <LinearLayout
        android:id="@+id/wallHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvWallTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:letterSpacing="0.10"
            android:text="@string/title_wall_of_kills"
            android:textColor="@color/blood_red"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWallSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:text="@string/subtitle_wall_of_kills"
            android:textColor="@color/subtitle_grey"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Leaderboard Container -->
    <ScrollView
        android:id="@+id/scrollLeaderboard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/btnReturnSurfaceWall"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/wallHeader">

        <LinearLayout
            android:id="@+id/leaderboardList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Top Player Entry (adi) -->
            <LinearLayout
                android:id="@+id/rowPlayerAdi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_leaderboard_row"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/tvAdiStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.04"
                    android:textColor="@color/text_silver"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="1. adi — Resonance: 160 | Victim Losses: 6" />
            </LinearLayout>

            <!-- Current Logged In Player Entry -->
            <LinearLayout
                android:id="@+id/rowCurrentUser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_leaderboard_user_row"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/tvCurrentUserStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.04"
                    android:textColor="#FF9900"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="2. adithya — Resonance: 0 | Victim Losses: 0" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Return Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnReturnSurfaceWall"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="36dp"
        android:background="@drawable/bg_enter_button"
        android:gravity="center"
        android:letterSpacing="0.06"
        android:minHeight="54dp"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:text="@string/btn_return_surface"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>