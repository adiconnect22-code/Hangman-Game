<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settingsMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    tools:context=".SettingsActivity">

    <!-- Top Header -->
    <TextView
        android:id="@+id/tvSettingsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:letterSpacing="0.10"
        android:text="@string/title_alter_environment"
        android:textColor="@color/blood_red"
        android:textSize="40sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/cardSettings"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5" />

    <!-- Center Card -->
    <LinearLayout
        android:id="@+id/cardSettings"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_login_card"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toTopOf="@id/btnReturnSurface"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSettingsTitle">

        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/cbMusic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:buttonTint="@color/blood_red"
            android:checked="true"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.04"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/option_music"
            android:textColor="@color/text_silver"
            android:textSize="13sp"
            android:textStyle="bold"
            app:buttonTint="@color/blood_red" />

        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/cbSfx"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:buttonTint="@color/blood_red"
            android:checked="true"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.04"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/option_sfx"
            android:textColor="@color/text_silver"
            android:textSize="13sp"
            android:textStyle="bold"
            app:buttonTint="@color/blood_red" />

        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/cbVibration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:buttonTint="@color/blood_red"
            android:checked="true"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.04"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/option_vibration"
            android:textColor="@color/text_silver"
            android:textSize="13sp"
            android:textStyle="bold"
            app:buttonTint="@color/blood_red" />

        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/cbDarkTheme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:buttonTint="@color/blood_red"
            android:checked="true"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.04"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/option_dark_theme"
            android:textColor="@color/text_silver"
            android:textSize="13sp"
            android:textStyle="bold"
            app:buttonTint="@color/blood_red" />

        <!-- Divider Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="20dp"
            android:background="#333333" />

        <!-- Logout Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_enter_button"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:minHeight="54dp"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp"
            android:text="@string/btn_logout"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Return Surface Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnReturnSurface"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="36dp"
        android:background="@drawable/bg_enter_button"
        android:gravity="center"
        android:letterSpacing="0.06"
        android:minHeight="54dp"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:text="@string/btn_return_surface"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>