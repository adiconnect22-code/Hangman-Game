<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/soulRecordMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    tools:context=".SoulRecordActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <!-- Top Header -->
            <LinearLayout
                android:id="@+id/soulHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintBottom_toTopOf="@id/cardSoulRecord"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.4">

                <TextView
                    android:id="@+id/tvSoulRecordTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:letterSpacing="0.10"
                    android:text="@string/title_soul_record"
                    android:textColor="@color/blood_red"
                    android:textSize="40sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSubjectId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.08"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="SUBJECT ID: ADITHYA" />
            </LinearLayout>

            <!-- Center Stats Card -->
            <LinearLayout
                android:id="@+id/cardSoulRecord"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_login_card"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingTop="24dp"
                android:paddingEnd="22dp"
                android:paddingBottom="24dp"
                app:layout_constraintBottom_toTopOf="@id/achievementsLayout"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/soulHeader">

                <TextView
                    android:id="@+id/tvRitualsPerformed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.06"
                    android:textColor="@color/text_silver"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="RITUALS PERFORMED: 0" />

                <TextView
                    android:id="@+id/tvEssencesSaved"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.06"
                    android:textColor="@color/text_silver"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="ESSENCES SAVED: 0" />

                <TextView
                    android:id="@+id/tvVictimLosses"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.06"
                    android:textColor="@color/blood_red"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="VICTIM LOSSES: 0" />

                <TextView
                    android:id="@+id/tvStabilityRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.06"
                    android:textColor="@color/text_silver"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="STABILITY RATE: 0%" />

                <TextView
                    android:id="@+id/tvHighestResonance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.06"
                    android:textColor="#FFB000"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="HIGHEST RESONANCE: 0" />

                <TextView
                    android:id="@+id/tvRescueStreak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.06"
                    android:textColor="@color/text_silver"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="RESCUE STREAK: 0" />
            </LinearLayout>

            <!-- Achievements Section -->
            <LinearLayout
                android:id="@+id/achievementsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                app:layout_constraintBottom_toTopOf="@id/btnReturnSurfaceSoul"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardSoulRecord">

                <TextView
                    android:id="@+id/tvUnlockedMarks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.08"
                    android:text="@string/header_unlocked_marks"
                    android:textColor="@color/subtitle_grey"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvNoMarks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/no_marks_text"
                    android:textColor="#666666"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Bottom Return Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnReturnSurfaceSoul"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_enter_button"
                android:gravity="center"
                android:letterSpacing="0.06"
                android:minHeight="54dp"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp"
                android:text="@string/btn_return_surface"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/achievementsLayout" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>